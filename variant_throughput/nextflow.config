outputDir = 'results'
workflow.output.mode = 'copy'

process {
    // SVAR2's batch-query API needs genoray>=3.3.1, which the shared `bench`
    // env can't provide (genvarloader caps genoray <3) -- see pixi.toml's
    // `svar2` feature. Every SVAR2 process activates that pixi env instead of
    // relying on the ambient PATH the other four methods share.
    //
    // `${projectDir}` is this file's directory (variant_throughput/), so this
    // resolves to the repo-root pixi.toml of whichever checkout/worktree is
    // actually running -- NOT a hardcoded path to one specific checkout.
    withName: 'BENCH_SVAR2_.*|BUILD_SVAR2_.*' {
        beforeScript = """
        export PATH="/carter/users/dlaub/.pixi/bin:\$PATH"
        eval "\$(pixi shell-hook -e svar2 --manifest-path ${projectDir}/../pixi.toml)"
        """
    }
}
